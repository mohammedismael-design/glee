# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://glee_user:glee_password@localhost:5432/glee_db?schema=public"

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Inventory hold TTL in seconds (default 600 = 10 minutes)
INVENTORY_HOLD_TTL_SECONDS=600

# Minutes before an AWAITING_PAYMENT booking is auto-cancelled (default 30)
STALE_BOOKING_TIMEOUT_MINUTES=30

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-very-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
EMAIL_VERIFY_SECRET=change-me-to-email-verify-secret

# ─────────────────────────────────────────────
# CORS & URLs
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://glee.com
FRONTEND_URL=https://glee.com
API_URL=https://api.glee.com

# ─────────────────────────────────────────────
# STRIPE PAYMENTS
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────
# PAYPAL (optional)
# ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

DEFAULT_CURRENCY=GBP

# ─────────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-key
EMAIL_FROM_ADDRESS=noreply@glee.com
EMAIL_FROM_NAME=Glee

# ─────────────────────────────────────────────
# SMS (Twilio) — optional
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# ─────────────────────────────────────────────
# PUSH NOTIFICATIONS — optional
# ─────────────────────────────────────────────
FCM_SERVER_KEY=

# ─────────────────────────────────────────────
# CLOUDINARY (media storage)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─────────────────────────────────────────────
# AWS S3 (alternative media storage)
# ─────────────────────────────────────────────
STORAGE_PROVIDER=cloudinary
AWS_S3_BUCKET=glee-media
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────
# MEDIA / UPLOAD SETTINGS
# ─────────────────────────────────────────────
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
WATERMARK_ENABLED=false
WATERMARK_IMAGE_PATH=

# ─────────────────────────────────────────────
# PII ENCRYPTION
# ─────────────────────────────────────────────
PII_ENCRYPTION_KEY=change-me-to-a-32-char-min-secret-key

# ─────────────────────────────────────────────
# GDPR
# ─────────────────────────────────────────────
GDPR_RETENTION_DAYS=30

# ─────────────────────────────────────────────
# MONITORING & LOGGING
# ─────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─────────────────────────────────────────────
# SEEDING (used by prisma/seed.ts only)
# ─────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@glee.com
SUPER_ADMIN_PASSWORD=ChangeMe@123!

# ─────────────────────────────────────────────
# PASSWORD RESET
# ─────────────────────────────────────────────
PASSWORD_RESET_EXPIRY_MINUTES=60
